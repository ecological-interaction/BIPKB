flowchart TB
    TITLE["BIPKB<br/>Bioindicators and Phenotypes Knowledge Base<br/>Biological characteristics, responses and qualified ecological interpretation"]
    subgraph CONTENT["Research content — candidate concepts and proposed navigation"]
        subgraph TERRITORIES["Selected research territories<br/>Navigation proposals, not a complete taxonomy"]
            T1["Organismal biology"]
            T2["Phenotype and<br/>phenomics"]
            T3["Functional ecology"]
            T4["Bioindication"]
            T5["Environmental<br/>responses"]
            T6["Ecological history"]
        end
        subgraph CHARACTERISTICS["Biological characteristics and responses"]
            BIOVALUES["Observable phenotypes · Functional traits<br/>Phenotypic plasticity · Organismal responses<br/>Genetic, developmental and environmental context"]
        end
        subgraph INTERPRETATION["Qualified ecological interpretation"]
            INFERVALUES["Indicator species · Environmental associations<br/>Calibration · Confounders · Timescale · Uncertainty<br/>Biological evidence is not a unique diagnosis"]
        end
    end
    DRM["DRM (developing) Database Reference Methodology<br/>Shared identities · Classifications and mappings · Relationships · Provenance<br/>Candidate methodology · Scientific authority remains with each database"]
    subgraph APPLICATIONS["Analysis, Intelligence and Applications<br/>Emerging research uses — not implemented analytical software"]
        USE1["Phenotype<br/>comparison"]
        USE2["Bioindicator<br/>interpretation"]
        USE3["Ecological response<br/>analysis"]
        USE4["Environmental<br/>assessment"]
    end
    TITLE --> CONTENT
    CONTENT <--> DRM
    DRM <--> APPLICATIONS
